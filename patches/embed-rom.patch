+//A rom slot inside the arm9 binary. It ships empty; tools/embed_rom.py (or the web patcher)
+//writes a rom into the finished .nds, which then boots straight into that game.
+//Layout: 16 byte magic, u32 rom size (0 = empty), 44 byte file name, then the rom.
+#define EMBED_HEADER_SIZE 64
+#define EMBED_SLOT_SIZE 0x80000
+__attribute__((aligned(4))) const volatile u8 embedded_rom_slot[EMBED_HEADER_SIZE + EMBED_SLOT_SIZE] = "NESDS-EMBED-SLOT";
+
+/*****************************
+* name:         load_embedded_rom
+* function:     boot the rom stored in embedded_rom_slot, if any.
+* description:  returns 1 when a rom was loaded, 0 when the slot is empty.
+*****************************/
+int load_embedded_rom() {
+	u32 size = embedded_rom_slot[16] | (embedded_rom_slot[17] << 8) | (embedded_rom_slot[18] << 16) | (embedded_rom_slot[19] << 24);
+	if (size < 16 || size > EMBED_SLOT_SIZE)
+		return 0;
+
+	char *roms = (char *)rom_start;
+	memcpy(roms, (const void *)(embedded_rom_slot + EMBED_HEADER_SIZE), size);
+
+	//the name is used for the .sav file next to the .nds (when a card filesystem is available)
+	int n = 0;
+	for (; n < 43 && embedded_rom_slot[20 + n]; n++)
+		romfilename[n] = embedded_rom_slot[20 + n];
+	romfilename[n] = 0;
+	if (n == 0 || !strrchr(romfilename, '.'))
+		strcpy(romfilename + n, n ? ".nes" : "embedded.nes");
+	romfileext = strrchr(romfilename, '.') + 1;
+
+	romsize = size;
+	if (size < 0x100000)
+		size = 0x100000;
+	freemem_start = ((u32)roms + size + 3) & ~3;
+	freemem_end = (u32)roms + ROM_MAX_SIZE;
+
+	romcorrect(roms);
+	initcart(roms);
+	IPC_MAPPER = globals.mapperNr;
+	load_sram();
+	return 1;
+}
